# Copy this file to .env and fill in what you need. Never share or upload your .env file.

# Hugging Face token: needed for Stable Audio Open (a gated model: accept its licence on its
# model page first). Create one at https://huggingface.co/settings/tokens (read access).
HF_TOKEN=

# Optional: General MIDI soundfont for realistic MIDI rendering with FluidSynth,
# e.g. FluidR3_GM.sf2. Without it, a built-in synthesiser is used.
SOUNDFONT_PATH=

# Optional and paid: Suno, the only option here that sings your lyrics with words.
# Suno has no official public API; point these at the endpoint you use and follow Suno's terms.
SUNO_API_BASE=
SUNO_API_KEY=

# Publish (Tattva) mode declarations. Set to yes only if true. They are recorded in the
# song's manifest as your declaration. Not needed for explore mode or the MIDI route.
# I have an active paid Suno plan that gives me ownership and commercial rights:
SUNO_PAID_PLAN=
# I have accepted the Stability AI Community License and I am below its annual revenue limit:
STABLE_AUDIO_LICENCE_ACCEPTED=
